{
  "name": "outlo",
  "productName": "Outlo",
  "version": "0.0.1",
  "description": "Mail client for the Linux desktop. Works with Outlook.com, Microsoft 365, Gmail and IMAP accounts.",
  "license": "GPL-3.0-only",
  "author": "SiroxCW <75880834+SiroxCW@users.noreply.github.com>",
  "homepage": "https://github.com/SiroxCW/Outlo",
  "repository": "github:SiroxCW/Outlo",
  "private": true,
  "main": "./out/main/index.js",
  "desktopName": "outlo.desktop",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "icons": "node scripts/build-icons.mjs",
    "package": "npm run build && electron-builder --linux",
    "postinstall": "install-electron"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fluentui/react-components": "^9.75.3",
    "@fluentui/react-icons": "^2.0.347",
    "@resvg/resvg-js": "^2.6.2",
    "@tanstack/react-virtual": "^3.14.28",
    "@types/node": "^24.9.0",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.16.0",
    "eslint-config-prettier": "^10.1.9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  }
}
